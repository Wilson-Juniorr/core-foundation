# Copie para .env e preencha com os valores do seu ambiente.
# Nunca versione valores reais (service-role, IA, UAZAPI, cron secret, etc.).

# Backend (cliente / browser) — chaves publishable
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Backend (servidor)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Secrets — apenas em variáveis de ambiente do servidor, nunca no repositório
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# UAZAPI_BASE_URL=
# UAZAPI_ADMIN_TOKEN=
# UAZAPI_INSTANCE_TOKEN=
# UAZAPI_INSTANCE_NAME=
# Secret exclusivo dos executores /api/public/hooks/* (cron). Server-side only.
# FOLLOWUP_CRON_SECRET=
