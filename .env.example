# Copie para .env e preencha com os valores do seu ambiente.
# Nunca versione valores reais (service-role, OpenAI, UZAPI, etc.).

# Backend (cliente / browser) — chaves publishable
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Backend (servidor)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Secrets — apenas em variáveis de ambiente do servidor, nunca no repositório
# SUPABASE_SERVICE_ROLE_KEY=
